# Supabase (même projet que le frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Utiliser service_role (pas anon) pour le worker

# Resend (emails)
RESEND_API_KEY=re_...
FROM_EMAIL=alertes@restocking.app

# Twilio (SMS, plan Pro uniquement)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# App
APP_URL=https://restocking.app

# Worker Configuration
CHECK_INTERVAL_PRO=300           # Check interval for Pro plan (seconds)
CHECK_INTERVAL_FREE=900          # Check interval for Free plan (seconds)
DOMAIN_DELAY_MIN=2               # Minimum delay between domain checks (seconds)
DOMAIN_DELAY_MAX=8               # Maximum delay between domain checks (seconds)
PORT=8000
# DEEPSEEK_API_KEY

# Discord (webhook notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# DeepSeek (LLM validation des produits extraits)
DEEPSEEK_API_KEY=sk-...
